# Copy to .env and edit. Never commit .env.
# Use only letters and digits in POSTGRES_PASSWORD (it is placed inside a URL).
POSTGRES_PASSWORD=changeMeDbPassword
API_KEY=change-me-api-key

# Optional: Telegram alerts (see README). Leave empty to disable delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local demo only. Lets the worker check private addresses such as the
# built-in /demo/flaky endpoint. Keep false anywhere real users add URLs.
ALLOW_PRIVATE_TARGETS=true
ENABLE_DEMO_ENDPOINTS=true
WORKER_REPLICAS=2
